<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">
    <LinearLayout
        android:id="@+id/progressIndicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/progress1"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@color/black" />
        <View
            android:id="@+id/progress2"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@color/profile_progress_inactive" />
        <View
            android:id="@+id/progress3"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@color/profile_progress_inactive" />
        <View
            android:id="@+id/progress4"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@color/profile_progress_inactive" />
        <View
            android:id="@+id/progress5"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@color/profile_progress_inactive" />
        <View
            android:id="@+id/progress6"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@color/profile_progress_inactive" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator" />
    <TextView
        android:id="@+id/tvProfileSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/profile_section"
        android:textColor="@color/login_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />
    <ViewFlipper
        android:id="@+id/profileSteps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/btnProfileContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProfileSection">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvPersonalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/personal_details_question"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:hint="@string/name_hint"
                app:boxStrokeColor="@color/profile_input_stroke"
                app:hintTextColor="@color/profile_input_hint"
                app:boxStrokeWidthFocused="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPersonalTitle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/black"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/tvUploadTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/upload_photo_question"
                android:textColor="@color/login_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/nameInputLayout" />
            <FrameLayout
                android:id="@+id/photoCaptureArea"
                android:layout_width="0dp"
                android:layout_height="350dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_photo_capture"
                android:clickable="true"
                android:contentDescription="@string/take_profile_photo"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUploadTitle">
                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivCamera"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/take_profile_photo"
                    android:src="@drawable/ic_camera" />
            </FrameLayout>
            <TextView
                android:id="@+id/tvPhotoHelp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/photo_help"
                android:textColor="@color/login_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/photoCaptureArea" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/living_space_question"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnApartment"
                android:text="@string/apartment"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnHouse"
                android:text="@string/house"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnStudio"
                android:text="@string/studio"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/city_question"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinnerCity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_profile_dropdown"
                android:popupBackground="@color/white"
                android:paddingStart="16dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/price_question"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvRentValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/rent_value"
                android:textColor="@color/login_text_primary"
                android:textStyle="bold" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="1000"
                android:valueFrom="0"
                android:valueTo="5000"
                app:thumbColor="@color/profile_option_selected"
                app:trackColorActive="@color/profile_option_selected"
                app:trackColorInactive="@color/profile_slider_inactive" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stay_question"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnStayOneYear"
                android:text="@string/stay_one_year"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnStaySixMonths"
                android:text="@string/stay_six_months"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnStayThreeMonths"
                android:text="@string/stay_three_months"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnStayShort"
                android:text="@string/stay_short"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/amenities_question"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnLaundry"
                android:text="@string/amenity_laundry"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnDishwasher"
                android:text="@string/amenity_dishwasher"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/profile_option"
                android:id="@+id/btnBalcony"
                android:text="@string/amenity_balcony"
                android:textColor="@color/login_text_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </ViewFlipper>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfileContinue"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/login_text_primary"
        android:text="@string/continue_label"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/introScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvIntroTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/profile_intro_title"
            android:textColor="@color/login_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvIntroDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />
        <TextView
            android:id="@+id/tvIntroDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/profile_intro_description"
            android:textColor="@color/login_text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/btnStartProfile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIntroTitle" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartProfile"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/login_text_primary"
            android:text="@string/start"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
